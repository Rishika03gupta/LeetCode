class Solution {
    public int[] countBits(int n) {
        int[] arr = new int[n + 1];  // result array to store count of 1s

        for (int i = 0; i <= n; i++) {
            int num = i;
            int count = 0;

            // count number of 1s in binary form of i
            while (num > 0) {
                count += num % 2;   // if last bit is 1
                num = num / 2;      // shift right by 1 bit
            }

            arr[i] = count; // store count of 1s for this i
        }

        return arr;  // return the full array
    }
}
